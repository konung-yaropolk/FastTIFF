{
  "name": "fasttiff-web",
  "private": true,
  "version": "0.9.6",
  "type": "module",
  "description": "Browser build of FastTIFF — the same Rust viewer core and GPU renderer, behind a React UI.",
  "scripts": {
    "wasm": "wasm-pack build crate --target web --out-dir ../src/wasm --release",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
